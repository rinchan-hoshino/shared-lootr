{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.rinchan.sharedlootr.SharedLootrFabric"],
    "jade": ["dev.rinchan.sharedlootr.integration.jade.SharedLootrJadePlugin"]
  },
  "mixins": ["shared_lootr.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "lootr": "*",
    "rinlib": ">=0.2.0"
  }
}
