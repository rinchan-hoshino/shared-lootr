{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.rinchan.sharedlootr.SharedLootrFabric"],
    "jade": ["dev.rinchan.sharedlootr.integration.jade.SharedLootrJadePlugin"]
  },
  "mixins": ["shared_lootr.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "lootr": ">=${lootr_version}",
    "rinlib": ">=${rinlib_version}"
  },
  "suggests": {
    "jade": "*"
  }
}
